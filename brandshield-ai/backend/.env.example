# =================================================================
# BrandShield AI - Environment Configuration Reference (.env.example)
# =================================================================

# Server & Database Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
MONGO_URI=mongodb://localhost:27017
DB_NAME=brandshield_ai
CORS_ORIGINS=http://localhost:5173

# Authentication & JWT Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEMO_USER_PASSWORD=

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Email / SMTP Configuration for Password Reset & Verification Emails
# Example using Gmail, SendGrid, Amazon SES, or custom SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=security@brandshield.ai
FRONTEND_URL=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false

# Social & Meta Graph APIs
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_DEMO_MODE=true
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_API_TIER=v2_free_basic
META_GRAPH_API_VERSION=v21.0
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PLATFORM_SANDBOX_MODE=true
