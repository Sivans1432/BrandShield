# ==========================================
# BrandShield AI - Global Environment Config
# Copy this file to .env before starting Docker
# ==========================================

# Database
MONGO_URI=mongodb://mongodb:27017
DB_NAME=brandshield_ai

# Security & Sessions
JWT_SECRET_KEY=replace_with_a_super_secret_cryptographic_key_min_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# URLs
FRONTEND_URL=http://localhost

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# SMTP Email Configuration (Optional - for Password Reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=security@brandshield.ai
REQUIRE_EMAIL_VERIFICATION=false

# Threat Intelligence Engine Modes
INSTAGRAM_DEMO_MODE=true
PLATFORM_SANDBOX_MODE=true
